            <!-- APU Detallado -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                <div class="flex items-center mb-4">
                    <i class="fa-solid fa-microscope text-blue-600 text-xl mr-3"></i>
                    <h3 class="text-xl font-bold text-slate-800">Análisis de Precio Unitario (APU) - Partida 03.02</h3>
                </div>
                <p class="text-sm text-slate-600 mb-4"><strong>Descripción:</strong> Concreto f'c=175 kg/cm² para veredas e=10cm inc. acabado frotachado y curado.<br><strong>Rendimiento:</strong> 120.00 m²/Día.</p>

                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead class="bg-slate-100 text-slate-600 border-b border-slate-300">
