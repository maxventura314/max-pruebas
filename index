                    <i class="fa-solid fa-download mr-2"></i> Exportar a Excel
                </button>
            </div>

            <!-- Tabla de Presupuesto -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-x-auto mb-10">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Ítem</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Descripción</th>
                            <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-slate-500 uppercase tracking-wider">Unid.</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Metrado</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Precio Unit. (S/)</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Parcial (S/)</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-200 text-sm">
                        <!-- Obras Preliminares -->
                        <tr class="bg-slate-50 font-semibold">
                            <td class="px-6 py-3">01.00</td>
                            <td colspan="5">OBRAS PRELIMINARES</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-3 text-slate-500">01.01</td>
                            <td class="px-6 py-3">Trazo, niveles y replanteo topográfico</td>
                            <td class="px-6 py-3 text-center">m²</td>
                            <td class="px-6 py-3 text-right">3,000.00</td>
                            <td class="px-6 py-3 text-right">1.50</td>
