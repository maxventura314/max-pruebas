                        </tr>
                        
                        <!-- Movimiento de tierras -->
                        <tr class="bg-slate-50 font-semibold">
                            <td class="px-6 py-3">02.00</td>
                            <td colspan="5">MOVIMIENTO DE TIERRAS</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-3 text-slate-500">02.01</td>
                            <td class="px-6 py-3">Corte y nivelación manual de terreno</td>
                            <td class="px-6 py-3 text-center">m²</td>
                            <td class="px-6 py-3 text-right">3,000.00</td>
                            <td class="px-6 py-3 text-right">8.50</td>
                            <td class="px-6 py-3 text-right font-medium">25,500.00</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-3 text-slate-500">02.02</td>
                            <td class="px-6 py-3">Eliminación de material excedente (D=5km)</td>
                            <td class="px-6 py-3 text-center">m³</td>
                            <td class="px-6 py-3 text-right">360.00</td> <!-- Considerando esponjamiento 20% sobre 300m3 -->
                            <td class="px-6 py-3 text-right">35.00</td>
                            <td class="px-6 py-3 text-right font-medium">12,600.00</td>
                        </tr>

                        <!-- Concreto Simple -->
                        <tr class="bg-slate-50 font-semibold">
                            <td class="px-6 py-3">03.00</td>
                            <td colspan="5">OBRAS DE CONCRETO SIMPLE (VEREDAS)</td>
                        </tr>
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-3 text-slate-500">03.01</td>
                            <td class="px-6 py-3">Encofrado y desencofrado normal para veredas</td>
                            <td class="px-6 py-3 text-center">m²</td>
                            <td class="px-6 py-3 text-right">600.00</td> <!-- Solo áreas laterales expuestas -->
                            <td class="px-6 py-3 text-right">28.00</td>
                            <td class="px-6 py-3 text-right font-medium">16,800.00</td>
                        </tr>
                        <tr class="hover:bg-blue-50 bg-blue-50/30">
                            <td class="px-6 py-3 text-slate-500">03.02</td>
                            <td class="px-6 py-3 font-semibold text-blue-700 cursor-pointer" title="Ver Análisis de Precio Unitario (APU) abajo">
                                Concreto f'c=175 kg/cm² para veredas e=10cm inc. curado <i class="fa-solid fa-circle-info ml-1 text-blue-400"></i>
                            </td>
                            <td class="px-6 py-3 text-center">m²</td>
                            <td class="px-6 py-3 text-right">3,000.00</td>
