    <script>
        // Función para cambiar de pestañas (Tabs)
        function openTab(tabName) {
            // Ocultar todos los contenidos
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => {
                content.classList.add('hidden');
            });

            // Quitar clase activa de todos los botones
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('active', 'border-blue-600', 'text-blue-600');
                btn.classList.add('border-transparent', 'text-slate-500');
            });

            // Mostrar el contenido seleccionado
            document.getElementById('tab-' + tabName).classList.remove('hidden');
            
            // Activar el botón seleccionado
            const activeBtn = document.getElementById('btn-' + tabName);
            activeBtn.classList.remove('border-transparent', 'text-slate-500');
            activeBtn.classList.add('active');

            // Renderizar el gráfico de Chart.js SOLO cuando se abre la pestaña de valorizaciones
            if(tabName === 'valorizaciones' && !window.chartRendered) {
                renderChart();
                window.chartRendered = true; // Para no renderizarlo varias veces
            }
        }

        // Función para inicializar el gráfico de la Curva S usando Chart.js
        function renderChart() {
            const ctx = document.getElementById('curvaSChart').getContext('2d');
            
            const dataProgramado = [0, 10, 25, 45, 65, 85, 100];
            const dataEjecutado = [0, 12, 24, 42.5, 62.5, null, null]; // Nulls para futuro
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Inicio', 'Sem 1', 'Sem 2', 'Sem 3', 'Sem 4', 'Sem 5', 'Sem 6'],
                    datasets: [
                        {
                            label: '% Avance Programado',
                            data: dataProgramado,
                            borderColor: '#2563eb', // blue-600
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            tension: 0.3,
                            fill: false
                        },
                        {
                            label: '% Avance Real',
                            data: dataEjecutado,
                            borderColor: '#22c55e', // green-500
                            backgroundColor: 'rgba(34, 197, 94, 0.2)',
                            borderWidth: 3,
                            pointBackgroundColor: '#22c55e',
                            pointRadius: 5,
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { font: { family: "'Inter', sans-serif" } }
                        },
                        title: {
                            display: true,
                            text: 'Curva S - Avance Acumulado de Proyecto',
                            font: { family: "'Inter', sans-serif", size: 16 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) { return value + "%" }
                            },
                            title: {
                                display: true,
                                text: 'Porcentaje (%)'
                            }
                        }
                    }
                }
            });
        }

        // Iniciar en la primera pestaña
        document.addEventListener('DOMContentLoaded', () => {
            window.chartRendered = false;
        });
    </script>
